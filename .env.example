# Mailchimp (optional — форма работает и без ключей, лид всё равно сохраняется через Upstash)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=us1

# Gemini (AI-приложения: ColdMessage, ObjectionKiller, LeadRadar)
GEMINI_API_KEY=

# Upstash Redis — дневной rate limit (30/день на все API) И постоянное хранилище
# лидов с форм (список "leads:landing"). Без него: rate limit падает в in-memory
# fallback, а лиды с форм только логируются и теряются после рестарта.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Токен для приватного просмотра сохранённых лидов: GET /api/leads
# с заголовком Authorization: Bearer <этот токен>. Без него эндпоинт всегда 401.
LEADS_ADMIN_TOKEN=

# Google Sheets — запись лидов с форм в таблицу через Apps Script Web App.
# Пошаговая настройка: docs/google-sheets-setup.md
# Без этих переменных лиды в таблицу не пишутся (в логах будет [sheets] warning).
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Resend — автоответ лиду сразу после отправки формы (приглашение на аудит).
# RESEND_API_KEY: ключ с resend.com. Без него автоответ просто не уходит —
# лид всё равно сохраняется (Upstash/Sheets) и передаётся в Mailchimp.
# RESEND_FROM_EMAIL: адрес отправителя. Без своего домена в Resend можно
# оставить пустым — используется общий тестовый домен onboarding@resend.dev.
# Пошаговая настройка: docs/resend-setup.md
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads — тег отслеживания конверсий (gtag.js).
# NEXT_PUBLIC_GOOGLE_ADS_ID: идентификатор аккаунта вида AW-XXXXXXXXXX. Без него
# тег вообще не подключается.
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL: метка конверсионного действия «лид» — вторая
# часть send_to (AW-XXXXXXXXXX/AbC-D_efGhIjKlM). Без неё тег стоит и собирает
# аудиторию для ремаркетинга, но конверсии с формы не отправляются.
# Пошаговая настройка: docs/google-ads-setup.md
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18392989021
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Umami Analytics (optional) — self-hosted instance at
# https://umami-production-398c.up.railway.app. Website ID is created in the
# Umami dashboard for this site. Without it, the tracking script is not injected.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
