# Mailchimp (optional — форма работает и без ключей, лид всё равно сохраняется через Upstash)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=us1

# Gemini (AI-приложения: ColdMessage, ObjectionKiller, LeadRadar)
GEMINI_API_KEY=

# Upstash Redis — дневной rate limit (30/день на все API) И постоянное хранилище
# лидов с форм (список "leads:landing"). Без него: rate limit падает в in-memory
# fallback, а лиды с форм только логируются и теряются после рестарта.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Токен для приватного просмотра сохранённых лидов: GET /api/leads
# с заголовком Authorization: Bearer <этот токен>. Без него эндпоинт всегда 401.
LEADS_ADMIN_TOKEN=

# Google Sheets — таблица для лидов с форм (см. src/lib/googleSheets.ts для настройки:
# Service Account в Google Cloud + Sheets API + расшарить таблицу на email аккаунта).
# GOOGLE_SHEETS_ID уже проставлен под таблицу:
# https://docs.google.com/spreadsheets/d/1v2_l2YfRr4sie83cK2j-icd5CL-Epp9MM7AW79MoZlY/edit
GOOGLE_SHEETS_ID=1v2_l2YfRr4sie83cK2j-icd5CL-Epp9MM7AW79MoZlY
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
